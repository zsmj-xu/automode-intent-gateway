# AutoMode Intent Gateway 部署配置示例
# 用法：cp .env.example .env，然后按需修改并 docker compose up -d --build

# ---------- 必填 ----------

# 上游模型服务地址（Agent 流量将转发到这里）
#  - 外部地址：https://api.example.com
#  - 宿主机上的服务（Linux 需 compose 里已加 extra_hosts）：http://host.docker.internal:4000
#  - 同 Docker 网络的其他容器：http://litellm:4000
AUTOMODE_UPSTREAM_BASE_URL=http://host.docker.internal:4000

# 管理端 Token（服务器部署必填，/api/* 需要 Authorization: Bearer <token>）
# 生成示例：openssl rand -hex 32
AUTOMODE_ADMIN_TOKEN=change-me-to-a-long-random-token

# ---------- 可选 ----------

# 宿主机对外监听端口（容器内固定 8787）
AUTOMODE_PORT=8787

# 上游统一 Bearer Key（不填则原样透传 Agent 的 Authorization）
AUTOMODE_UPSTREAM_API_KEY=

# Fast（无思考）分类器 —— 兼容 OpenAI Chat Completions 接口
# 注意：URL 必须是完整的 chat/completions 端点，如 https://xxx/v1/chat/completions
AUTOMODE_FAST_URL=
AUTOMODE_FAST_MODEL=
AUTOMODE_FAST_API_KEY=

# Deep（带思考）分类器
# 注意：URL 同样需要完整的 /v1/chat/completions 路径
AUTOMODE_DEEP_URL=
AUTOMODE_DEEP_MODEL=
AUTOMODE_DEEP_API_KEY=

# 进阶调优（一般无需修改）
# AUTOMODE_FAST_TIMEOUT=10
# AUTOMODE_FAST_MAX_TOKENS=2400
# AUTOMODE_DEEP_TIMEOUT=10
# AUTOMODE_DEEP_MAX_TOKENS=2400
# AUTOMODE_RESPONSE_CAPTURE_BYTES=8388608
# AUTOMODE_DB_FLUSH_INTERVAL_MS=25
